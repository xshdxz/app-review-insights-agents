DEEPSEEK_API_KEY=
MODEL_ENABLED=true
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=8192
DATABASE_PATH=data/runs/runs.sqlite3
DEFAULT_REVIEW_LIMIT=500
BATCH_REVIEW_LIMIT=100
BATCH_MAX_CHARACTERS=60000

# --- 多 Agent 产品情报系统（新增） ---
# 可切换的模型密钥（留空则回退用 DEEPSEEK_API_KEY）
MODEL_API_KEY=
# 群机器人类型：feishu / dingtalk / wecom / slack（留空=不推送）
WEBHOOK_TYPE=
# 多个 Webhook 地址用英文逗号分隔
WEBHOOK_URLS=
# 是否在本进程启动定时调度（web 默认关，worker 容器开）
SCHEDULER_ENABLED=false
# Reviewer 复核不通过时最多重做轮数
AGENT_MAX_REVIEW_ROUNDS=2
# 报告推送前是否需要人工审批
APPROVAL_REQUIRED=false
# 向量检索（可选；关闭时 RAG 仅用 FTS5）
# 优先本地模型（EMBEDDING_LOCAL_MODEL_PATH），其次 API（EMBEDDING_API_KEY）
EMBEDDING_ENABLED=false
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Agent/监控/RAG 状态库
AGENT_DB_PATH=data/agent/agent.sqlite3
# 社交舆情 X 端点（可选；返回 JSON 数组：[{"id","text","author","created_at"}]）
SOCIAL_X_ENDPOINT=
# worker 健康/指标端点（Docker healthcheck 与 Prometheus 抓取使用）
# /healthz 存活、/readyz 就绪、/metrics Prometheus 文本
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=9100
