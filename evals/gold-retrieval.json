{
  "corpus": "evals/gold-reviews.json",
  "note": "检索评测的查询集：答案锚定既有黄金集的 expected_review_ids，不另造一套标注口径。查询写成「用户会怎么问」而不是照抄评论原句——照抄的话词面检索必然命中，测不出任何东西。语料是中英混排的，查询也分中英两组：lexical 检索跨不了语言，这一点由数据本身暴露（看 language 分组统计），而那正是向量那一路要负责的事——本机没有 embedding provider，所以那一路标注为未测。",
  "queries": [
    {
      "query_id": "q-trial-billing",
      "query": "charged when the free trial ended without any warning",
      "expected_review_ids": [
        "e2-01",
        "e2-02"
      ],
      "language": "en",
      "note": "试用结束即扣款、取消仍被收费"
    },
    {
